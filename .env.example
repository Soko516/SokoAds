<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SokoAds | Live marketplace</title>
    <style>
      :root {
        --bg: #f3f6fb;
        --panel: #ffffff;
        --navy: #0f172a;
        --orange: #ff7a00;
        --muted: #64748b;
        --border: #e2e8f0;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: var(--bg);
        color: var(--navy);
      }
      a { text-decoration: none; color: inherit; }
      .container { width: min(1120px, calc(100% - 32px)); margin: 0 auto; }
      header {
        background: white;
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        z-index: 10;
      }
      .nav {
        display: flex; align-items: center; justify-content: space-between; height: 72px;
      }
      .brand { font-size: 2rem; font-weight: 800; letter-spacing: -0.04em; }
      .brand span { color: var(--orange); }
      nav { display: flex; gap: 18px; color: var(--muted); }
      .hero { padding: 64px 0 32px; }
      .hero-grid { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 24px; align-items: center; }
      h1 { font-size: clamp(2.2rem, 4vw, 4rem); line-height: 1.06; margin: 0 0 18px; }
      p { color: var(--muted); line-height: 1.6; }
      .actions { display: flex; gap: 14px; flex-wrap: wrap; }
      .btn {
        border: none; cursor: pointer; border-radius: 12px; padding: 14px 22px; font-weight: 700; font-size: 1rem;
        transition: transform 0.15s ease; display: inline-flex; justify-content: center; align-items: center;
      }
      .btn:hover { transform: translateY(-1px); }
      .btn.primary { background: var(--orange); color: white; }
      .btn.secondary { background: var(--navy); color: white; }
      .card {
        background: white; border: 1px solid var(--border); border-radius: 18px; box-shadow: 0 12px 24px rgba(15, 23, 42, .05);
      }
      .hero-card { padding: 20px; }
      .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 16px; }
      .stat { padding: 18px 15px; background: #f8fafc; border: 1px solid var(--border); border-radius: 12px; }
      .stat strong { display: block; font-size: 1.6rem; margin-top: 8px; }
      section { padding: 28px 0; }
      .section-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }
      h2 { margin: 0; }
      .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
      .ad-card { overflow: hidden; }
      .ad-card img { width: 100%; height: 220px; object-fit: cover; display: block; }
      .ad-body { padding: 18px; }
      .tag { display: inline-block; padding: 6px 10px; background: #eef2ff; color: #4338ca; border-radius: 999px; font-size: .72rem; font-weight: 700; }
      .price { font-size: 1.7rem; font-weight: 800; margin: 16px 0 12px; }
      .form-shell { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 20px; }
      form { background: white; border: 1px solid var(--border); border-radius: 18px; padding: 22px; }
      .two-col { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
      label { display: block; color: var(--muted); margin-bottom: 8px; font-size: .9rem; }
      input, select, textarea {
        width: 100%; border: 1px solid var(--border); border-radius: 12px; padding: 12px 14px; font-size: 1rem; background: white;
      }
      textarea { min-height: 120px; resize: vertical; }
      .pricing-block { padding: 20px; }
      .pricing-list { display: grid; gap: 14px; margin-top: 18px; }
      .pricing-item { display: flex; justify-content: space-between; align-items: center; padding: 14px 16px; background: #f8fafc; border-radius: 12px; border: 1px solid var(--border); }
      .admin-strip { display: flex; justify-content: space-between; gap: 20px; align-items: center; padding: 24px; background: white; border: 1px solid var(--border); border-radius: 18px; }
      .modal {
        position: fixed; inset: 0; background: rgba(15, 23, 42, 0.66); display: none; align-items: center; justify-content: center; z-index: 30; padding: 20px;
      }
      .modal.show { display: flex; }
      .modal-box { width: min(620px, 100%); background: white; border-radius: 18px; padding: 26px; }
      .close { float: right; border: none; background: transparent; font-size: 1.8rem; cursor: pointer; }
      .toast {
        position: fixed; right: 20px; bottom: 20px; display: none; background: var(--navy); color: white; padding: 12px 16px; border-radius: 12px; box-shadow: 0 12px 20px rgba(15, 23, 42, .16);
      }
      footer { padding: 28px 0 44px; color: var(--muted); }
      @media (max-width: 850px) {
        nav { display: none; }
        .hero-grid, .form-shell, .grid { grid-template-columns: 1fr; }
        .two-col, .stats { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="container nav">
        <div class="brand">Soko<span>Ads</span></div>
        <nav>
          <a href="#ads">Ads</a>
          <a href="#sell">Sell</a>
          <a href="#pricing">Pricing</a>
          <a href="#admin">Admin</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container hero-grid">
          <div>
            <h1>Sell faster. Reach buyers. Get paid live.</h1>
            <p>Launch trusted listings in Tanzania with secure checkout powered by PesaPal. Built for live deployment on HTTPS.</p>
            <div class="actions">
              <a class="btn primary" href="#sell">Create ad</a>
              <a class="btn secondary" href="#ads">Browse listings</a>
            </div>
            <div class="stats">
              <div class="stat"><span>Live checkout</span><strong>PesaPal</strong></div>
              <div class="stat"><span>Payment</span><strong>Live</strong></div>
              <div class="stat"><span>Setup</span><strong>HTTPS</strong></div>
            </div>
          </div>
          <div class="card hero-card">
            <h3>Marketplace overview</h3>
            <p>Use the server-side payment flow to create orders, redirect users to PesaPal, verify transactions, and update listing status after successful payment.</p>
            <div class="pricing-list">
              <div class="pricing-item"><span>Basic</span><strong>TZS 2,000</strong></div>
              <div class="pricing-item"><span>Featured</span><strong>TZS 5,000</strong></div>
              <div class="pricing-item"><span>Premium</span><strong>TZS 10,000</strong></div>
            </div>
          </div>
        </div>
      </section>

      <section id="ads">
        <div class="container">
          <div class="section-head"><h2>Latest ads</h2></div>
          <div id="adsGrid" class="grid"></div>
        </div>
      </section>

      <section id="sell">
        <div class="container form-shell">
          <form id="adForm">
            <h2>Create ad</h2>
            <div class="two-col">
              <div>
                <label>Ad title</label>
                <input id="adName" required placeholder="e.g. Toyota Noah 2017" />
              </div>
              <div>
                <label>Category</label>
                <select id="adCategory">
                  <option>Vehicles</option>
                  <option>Electronics</option>
                  <option>Property</option>
                  <option>Fashion</option>
                  <option>Home</option>
                  <option>Services</option>
                </select>
              </div>
            </div>

            <div style="margin-top: 14px;">
              <label>Price (TZS)</label>
              <input id="adPrice" type="number" min="1000" value="2000" required />
            </div>

            <div style="margin-top: 14px;">
              <label>Package</label>
              <select id="adPackage">
                <option>Basic</option>
                <option>Featured</option>
                <option>Premium</option>
              </select>
            </div>

            <div style="margin-top: 14px;">
              <label>Description</label>
              <textarea id="adDescription" placeholder="Describe the item or service"></textarea>
            </div>

            <div style="margin-top: 14px;">
              <label>Image URL</label>
              <input id="adImage" placeholder="https://..." />
            </div>

            <div style="margin-top: 20px;">
              <button class="btn primary" type="submit">Submit ad</button>
            </div>
          </form>

          <div class="card pricing-block" id="pricing">
            <h3>Pricing</h3>
            <div class="pricing-list">
              <div class="pricing-item"><span>Basic</span><strong>TZS 2,000</strong></div>
              <div class="pricing-item"><span>Featured</span><strong>TZS 5,000</strong></div>
              <div class="pricing-item"><span>Premium</span><strong>TZS 10,000</strong></div>
            </div>
            <p style="margin-top: 18px;">Production payment flow requires real PesaPal live credentials and HTTPS domain.</p>
          </div>
        </div>
      </section>

      <section id="admin">
        <div class="container admin-strip">
          <div>
            <h2>Admin access</h2>
            <p>Use the configured admin password to view listing status and register the IPN URL.</p>
          </div>
          <button class="btn secondary" id="adminBtn">Open admin</button>
        </div>
      </section>
    </main>

    <footer>
      <div class="container">© 2026 SokoAds — marketplace and payment platform.</div>
    </footer>

    <div id="paymentModal" class="modal" role="dialog" aria-modal="true">
      <div class="modal-box">
        <button type="button" class="close" id="closeModal">×</button>
        <h2>Complete payment</h2>
        <p id="paymentSummary" class="muted"></p>
        <form id="paymentForm">
          <div class="two-col">
            <div>
              <label>First name</label>
              <input id="firstName" required />
            </div>
            <div>
              <label>Last name</label>
              <input id="lastName" required />
            </div>
          </div>
          <div style="margin-top: 14px;">
            <label>Email</label>
            <input id="email" type="email" required />
          </div>
          <div style="margin-top: 14px;">
            <label>Phone</label>
            <input id="phone" required />
          </div>
          <div style="margin-top: 20px;">
            <button class="btn primary" type="submit">Pay with PesaPal</button>
          </div>
        </form>
      </div>
    </div>

    <div id="toast" class="toast"></div>

    <script>
      const adsGrid = document.getElementById('adsGrid');
      const paymentModal = document.getElementById('paymentModal');
      const paymentSummary = document.getElementById('paymentSummary');
      const toast = document.getElementById('toast');
      let pendingAd = null;

      function showToast(message) {
        toast.textContent = message;
        toast.style.display = 'block';
        setTimeout(() => { toast.style.display = 'none'; }, 2600);
      }

      function formatTZS(amount) {
        return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'TZS', maximumFractionDigits: 0 }).format(amount || 0);
      }

      async function loadAds() {
        const response = await fetch('/api/ads');
        const ads = await response.json();
        adsGrid.innerHTML = '';

        if (!ads.length) {
          adsGrid.innerHTML = '<div class="card" style="padding: 24px;">No ads yet. Create the first listing.</div>';
          return;
        }

        ads.forEach((ad) => {
          const card = document.createElement('article');
          card.className = 'card ad-card';
          card.innerHTML = `
            <img src="${ad.image || 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=1200'}" alt="${ad.name}" />
            <div class="ad-body">
              <span class="tag">${ad.category || 'General'}</span>
              <h3>${ad.name}</h3>
              <p>${ad.description || 'No description provided.'}</p>
              <div class="price">${formatTZS(ad.price)}</div>
              <button class="btn primary" data-id="${ad.id}">Pay now</button>
            </div>
          `;
          card.querySelector('button').addEventListener('click', () => openPaymentModal(ad));
          adsGrid.appendChild(card);
        });
      }

      function openPaymentModal(ad) {
        pendingAd = ad;
        paymentSummary.textContent = `You are paying for "${ad.name}" (${ad.packageType || 'Basic'}). Total: ${formatTZS(ad.price)}`;
        paymentModal.classList.add('show');
      }

      document.getElementById('closeModal').addEventListener('click', () => {
        paymentModal.classList.remove('show');
      });

      document.getElementById('adForm').addEventListener('submit', async (event) => {
        event.preventDefault();
        const payload = {
          name: document.getElementById('adName').value,
          category: document.getElementById('adCategory').value,
          price: document.getElementById('adPrice').value,
          packageType: document.getElementById('adPackage').value,
          description: document.getElementById('adDescription').value,
          image: document.getElementById('adImage').value,
        };

        const response = await fetch('/api/ads', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const result = await response.json();
        if (!response.ok) {
          showToast(result.error || 'Could not create ad.');
          return;
        }

        showToast('Ad created successfully. Complete payment to publish it.');
        document.getElementById('adForm').reset();
        await loadAds();
        openPaymentModal(result.ad);
      });

      document.getElementById('paymentForm').addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!pendingAd) return showToast('No ad selected.');

        const payload = {
          firstName: document.getElementById('firstName').value,
          lastName: document.getElementById('lastName').value,
          email: document.getElementById('email').value,
          phone: document.getElementById('phone').value,
          packageType: pendingAd.packageType || 'Basic',
        };

        const response = await fetch(`/api/ads/${pendingAd.id}/pay`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const result = await response.json();
        if (!response.ok) {
          showToast(result.error || 'Payment initialization failed.');
          return;
        }

        paymentModal.classList.remove('show');
        if (result.redirectUrl) {
          window.location.href = result.redirectUrl;
          return;
        }

        showToast('Payment initialized successfully.');
      });

      document.getElementById('adminBtn').addEventListener('click', async () => {
        const password = prompt('Enter admin password');
        if (!password) return;

        const loginResponse = await fetch('/api/admin/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password }),
        });

        const loginData = await loginResponse.json();
        if (!loginResponse.ok) {
          showToast(loginData.error || 'Incorrect password');
          return;
        }

        const adminAdsResponse = await fetch('/api/admin/ads', {
          headers: { 'x-admin-token': loginData.token },
        });

        const ads = await adminAdsResponse.json();
        if (!adminAdsResponse.ok) {
          showToast('Admin access failed');
          return;
        }

        const summary = ads.map((ad) => `- ${ad.name} | ${ad.status || 'pending'} | ${formatTZS(ad.price)}`).join('\n');
        alert(`Admin ads\n\n${summary}`);
      });

      loadAds();
    </script>
  </body>
</html>
