<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SokoAds | Payment result</title>
    <style>
      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: #f3f6fb;
        color: #0f172a;
      }
      .wrap {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 24px;
      }
      .box {
        width: min(620px, 100%);
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 28px;
        text-align: center;
        box-shadow: 0 12px 28px rgba(15, 23, 42, .06);
      }
      .badge {
        display: inline-block;
        padding: 8px 14px;
        border-radius: 999px;
        font-weight: 700;
      }
      .success { background: #dcfce7; color: #166534; }
      .failed { background: #fee2e2; color: #991b1b; }
      a {
        display: inline-block; margin-top: 18px; text-decoration: none; color: white; background: #ff7a00; padding: 12px 18px; border-radius: 12px; font-weight: 700;
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <div class="box">
        <div id="statusBadge" class="badge success">Payment status</div>
        <h1 id="title">Payment successful</h1>
        <p id="message">Your order has been received and your ad is now being processed.</p>
        <a href="/">Back to homepage</a>
      </div>
    </div>

    <script>
      const params = new URLSearchParams(window.location.search);
      const status = params.get('status') || 'failed';
      const badge = document.getElementById('statusBadge');
      const title = document.getElementById('title');
      const message = document.getElementById('message');

      if (status === 'success') {
        badge.className = 'badge success';
        title.textContent = 'Payment successful';
        message.textContent = 'Your transaction was confirmed. Your listing is now active.';
      } else {
        badge.className = 'badge failed';
        title.textContent = 'Payment not completed';
        message.textContent = 'Your payment could not be confirmed yet. Please try again or contact support.';
      }
    </script>
  </body>
</html>
